---
import type { Homepage } from "../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
const initials = page.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<section class="profile-card" id="about" aria-labelledby="profile-title">
  <span class="availability">✦ Available ✦</span>
  <div class="profile-copy">
    <h2 id="profile-title">{page.name}</h2>
    <p>{page.introduction}</p>
  </div>
  <div
    class="portrait-placeholder"
    aria-label={`${page.name} portrait placeholder`}
    role="img"
  >
    <span>{initials}</span>
  </div>
</section>
