---
import type { Homepage } from "../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
---

<section class="masthead" aria-labelledby="hero-title">
  <p>
    {page.availability.split("·").at(-1)?.trim() ?? new Date().getFullYear()}
  </p>
  <h1 id="hero-title">
    Portafolio<span>.</span>
  </h1>
</section>
