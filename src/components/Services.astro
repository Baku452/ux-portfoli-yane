---
import { Icon } from "astro-icon/components";
import type { Labels, Service } from "../content/homepage";

interface Props {
  services: Service[];
  experienceStartYear: number;
  projectCount: string;
  labels: Labels;
}

const { services, experienceStartYear, projectCount, labels } = Astro.props;
const yearsExperience = new Date().getFullYear() - experienceStartYear;
---

<section class="work-grid" id="work" aria-label={labels.portfolioOverview}>
  <a
    class="featured-work"
    href="#services"
    aria-label={labels.viewSelectedWork}
  >
    <span class="project-kicker">{labels.selectedWork}</span>
    <span class="project-arrow">
      <Icon name="hugeicons:arrow-up-right-01" size={18} />
    </span>
    <div class="project-window" aria-hidden="true">
      <div class="window-bar">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <div class="window-body">
        <strong>UX/UI</strong>
        <span></span>
        <span></span>
      </div>
    </div>
  </a>

  <div class="metrics">
    <article class="metric experience">
      <strong>+ {String(yearsExperience).padStart(2, "0")}</strong>
      <span>{labels.yearsExperience}</span>
    </article>
    <article class="metric projects">
      <strong>+ {projectCount}</strong>
      <span>{labels.projects}</span>
    </article>
  </div>

  <div class="service-strip" id="services">
    {services.map((service) => (
      <span>{service.title}</span>
    ))}
  </div>
</section>
