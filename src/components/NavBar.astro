---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  email: string;
}

const { name, email } = Astro.props;
---

<header>
  <a class="brand" href="#top" aria-label={`${name}, home`}>
    {name}
  </a>
  <nav aria-label="Primary navigation">
    <a href="#about">About</a>
    <a href={`mailto:${email}`}>
      Let’s talk
      <Icon name="hugeicons:arrow-up-right-01" size={16} aria-hidden="true" />
    </a>
  </nav>
</header>
