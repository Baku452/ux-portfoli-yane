---
import { Icon } from "astro-icon/components";

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<aside class="side-rail">
  <a class="monogram" href="#top" aria-label="Go to top">
    Y
  </a>
  <nav aria-label="Primary navigation">
    <a class="active" href="#top" aria-label="Home">
      <Icon name="hugeicons:home-01" size={20} />
    </a>
    <a href="#work" aria-label="Selected work">
      <Icon name="hugeicons:grid-view" size={20} />
    </a>
    <a href="#about" aria-label="About">
      <Icon name="hugeicons:user" size={20} />
    </a>
    <a href={`mailto:${email}`} aria-label="Email">
      <Icon name="hugeicons:mail-01" size={20} />
    </a>
  </nav>
  <a class="rail-mail" href={`mailto:${email}`} aria-label="Email">
    <Icon name="hugeicons:mail-01" size={19} />
  </a>
</aside>
