---
import About from "./home/About.astro";
import AboutMe from "./home/about-me/AboutMe.astro";
import Contact from "./home/Contact.astro";
import Footer from "./home/Footer.astro";
import Hero from "./home/Hero.astro";
import Projects from "./home/projects/Projects.astro";
import StudyCase from "./home/study-case/StudyCase.astro";
import Services from "./home/Services.astro";
import LanguageSwitch from "./site/LanguageSwitch.astro";
import NavBar from "./site/NavBar.astro";
import type { Homepage } from "../content/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
---

<BaseLayout
  title={`${page.name} — ${page.role}`}
  description={page.introduction}
  lang={page.locale}
>
  <div class="site-shell" id="top">
    <NavBar labels={page.labels} />
    <LanguageSwitch locale={page.locale} label={page.labels.languageSwitch} />
    <main class="content-layout">
      <div class="portfolio-grid">
        <About page={page} />
        <div class="dashboard">
          <Hero page={page} />
          <Services
            services={page.services}
            experienceStartYear={page.experienceStartYear}
            projectCount={page.projectCount}
            labels={page.labels}
          />
          <Footer
            role={page.role}
            about={page.aboutBody}
            location={page.location}
            resumeUrl={page.resumeUrl}
            labels={page.labels}
          />
        </div>
      </div>
      <Projects page={page} />
      <StudyCase page={page} />
      <AboutMe page={page} />
      <Contact page={page} />
    </main>
  </div>
</BaseLayout>
