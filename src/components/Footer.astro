---
import { Icon } from "astro-icon/components";

interface Props {
  role: string;
  about: string;
  location: string;
  resumeUrl: string;
}

const { role, about, location, resumeUrl } = Astro.props;
---

<section class="details-grid" aria-label="Profile details">
  <article class="role-card">
    <h2>{role}</h2>
    <p>{about}</p>
  </article>
  <div class="quick-links">
    <span>
      <Icon name="hugeicons:location-01" size={20} /> {location}
    </span>
    <a href={resumeUrl} download>
      <Icon name="hugeicons:download-04" size={20} /> Download CV
    </a>
  </div>
</section>
