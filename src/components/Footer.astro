---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  email: string;
}

const { name, email } = Astro.props;
---

<footer>
  <p>Have a product worth making clear?</p>
  <a href={`mailto:${email}`}>
    Start a conversation
    <Icon name="hugeicons:arrow-up-right-01" size={16} aria-hidden="true" />
  </a>
  <small>
    © {new Date().getFullYear()} {name}
  </small>
</footer>
