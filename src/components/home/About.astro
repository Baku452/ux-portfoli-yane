---
import { Image } from "astro:assets";
import profileImage from "../../assets/profile.png";
import type { Homepage } from "../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
---

<section class="profile-card" id="about" aria-labelledby="profile-title">
  <span class="availability">✦ Ayab ✦</span>
  <div class="profile-copy">
    <h2 id="profile-title">{page.name}</h2>
    <p>{page.introduction}</p>
  </div>
  <div class="portrait">
    <Image
      class="portrait-image"
      src={profileImage}
      alt={page.labels.portraitAlt}
      width={305}
      height={394}
      quality={90}
      loading="eager"
    />
  </div>
</section>
