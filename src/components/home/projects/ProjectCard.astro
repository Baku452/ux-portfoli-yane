---
import type { Project } from "../../../content/homepage";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="project-card" href={project.url}>
  <span class="project-client">{project.client}</span>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
</a>

<style>
  .project-card {
    display: block;
    min-height: 305px;
    padding: 72px 40px 40px;
    border-radius: 28px;
    background: var(--illustration-main);
  }
  .project-client {
    display: inline-block;
    margin-bottom: 28px;
    padding: 8px 14px;
    border: 1px solid var(--card-pill-border);
    border-radius: 999px;
    background: var(--card-pill-background);
    color: var(--highlight-purple);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
  }
  h3 {
    margin: 0;
    color: var(--subheadline);
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 500;
    letter-spacing: 0.025em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  p {
    max-width: 47ch;
    margin: 16px 0 0;
    color: color-mix(
      in srgb,
      var(--subheadline) 55%,
      var(--illustration-main)
    );
    font-size: 1rem;
    line-height: 1.55;
  }
  @media (max-width: 650px) {
    .project-card {
      min-height: 0;
      padding: 40px 28px;
    }
  }
</style>
