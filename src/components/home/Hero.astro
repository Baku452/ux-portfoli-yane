---
import type { Homepage } from "../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
---

<section
  data-nav-section
  class="masthead"
  aria-labelledby="hero-title"
  id="top"
>
  <p>
    {page.availability.split("·").at(-1)?.trim() ?? new Date().getFullYear()}
  </p>
  <h1 id="hero-title">
    {page.labels.portfolio}
    <span>.</span>
  </h1>
</section>
