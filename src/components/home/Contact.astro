---
import contactPortrait from "../../assets/contact-portrait.png";
import type { Homepage } from "../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
const contactRows = [
  { label: "Email", value: page.email, href: `mailto:${page.email}` },
  { label: "LinkedIn", value: page.contact.linkedIn, href: "#contact" },
  { label: "Behance", value: page.contact.behance, href: "#contact" },
];
---

<section
  data-nav-section
  class="contact-section"
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="contact-copy">
    <p class="section-eyebrow">{page.contact.eyebrow}</p>
    <h2 class="section-title" id="contact-title">{page.contact.title}</h2>
    <p class="contact-description">{page.contact.description}</p>

    <dl class="contact-links">
      {contactRows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd><a href={row.href}>{row.value}</a></dd>
        </div>
      ))}
    </dl>
  </div>

  <img
    class="contact-portrait"
    src={contactPortrait.src}
    width={contactPortrait.width}
    height={contactPortrait.height}
    alt={page.labels.portraitAlt}
  />
</section>

<style>
  .contact-section {
    display: grid;
    width: min(1180px, calc(100% - 64px));
    grid-template-columns: minmax(0, 1fr) minmax(280px, 370px);
    align-items: center;
    gap: clamp(40px, 7vw, 110px);
    margin: 0 auto;
    padding: clamp(44px, 6vw, 76px);
    border: 1px solid color-mix(in srgb, var(--featured-pill-border) 16%, transparent);
    border-radius: 34px;
    background: var(--contact-gradient);
    scroll-margin-top: 24px;
  }
  .contact-copy {
    min-width: 0;
  }
  .contact-copy .section-eyebrow {
    margin-bottom: 20px;
  }
  .contact-copy .section-title {
    margin-bottom: 24px;
  }
  .contact-description {
    max-width: 60ch;
    margin: 0;
    color: color-mix(in srgb, var(--headline) 60%, var(--illustration-main));
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
  }
  .contact-links {
    display: grid;
    gap: 0;
    margin: clamp(36px, 5vw, 74px) 0 0;
  }
  .contact-links div {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid color-mix(in srgb, var(--featured-pill-border) 20%, transparent);
  }
  .contact-links div:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--featured-pill-border) 20%, transparent);
  }
  .contact-links dt,
  .contact-links dd {
    margin: 0;
  }
  .contact-links dt {
    color: var(--headline);
  }
  .contact-links a {
    color: var(--headline);
  }
  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--subheadline);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .contact-portrait {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 28px;
    filter: grayscale(1);
  }
  @media (max-width: 760px) {
    .contact-section {
      width: calc(100% - 28px);
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 28px;
    }
    .contact-portrait {
      max-width: 370px;
    }
    .contact-links {
      margin-top: 36px;
    }
  }
  @media (max-width: 480px) {
    .contact-links div {
      min-height: 58px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }
  }
</style>
