---
import contactPortrait from "../../assets/contact-portrait.png";
import type { Homepage } from "../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
const contactRows = [
  { label: "Email", value: page.email, href: `mailto:${page.email}` },
  { label: "LinkedIn", value: page.contact.linkedIn, href: "#contact" },
  { label: "Behance", value: page.contact.behance, href: "#contact" },
];
---

<section
  data-nav-section
  class="contact-section"
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="contact-copy">
    <p class="section-eyebrow">{page.contact.eyebrow}</p>
    <h2 class="section-title" id="contact-title">
      {page.contact.title}
    </h2>
    <p class="contact-description">{page.contact.description}</p>

    <dl class="contact-links">
      {contactRows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>
            <a href={row.href}>{row.value}</a>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="contact-portrait-container">
    <img
      class="contact-portrait"
      src={contactPortrait.src}
      width={contactPortrait.width}
      height={contactPortrait.height}
      alt={page.labels.portraitAlt}
    />
  </div>
</section>

<style>
  .contact-section {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 370px);
    align-items: center;
    gap: clamp(40px, 7vw, 110px);
    margin: 0;
    padding: clamp(44px, 6vw, 76px);
    border: 1px solid
      color-mix(in srgb, var(--featured-pill-border) 16%, transparent);
    border-radius: 34px;
    background: var(--contact-gradient);
    scroll-margin-top: 24px;
  }
  .contact-copy {
    min-width: 0;
  }
  .contact-copy .section-eyebrow {
    margin-bottom: 20px;
  }
  .contact-copy .section-title {
    margin-bottom: 14px;
  }
  .contact-description {
    max-width: 60ch;
    margin: 0;
    color: color-mix(in srgb, var(--headline) 60%, var(--illustration-main));
    font-size: 14.5px;
    line-height: 1.5;
  }
  .contact-links {
    display: grid;
    gap: 0;
    margin: clamp(36px, 5vw, 74px) 0 0;
    font-size: 13px;
  }
  .contact-links div {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid
      color-mix(in srgb, var(--featured-pill-border) 20%, transparent);
  }
  .contact-links div:last-child {
    border-bottom: 1px solid
      color-mix(in srgb, var(--featured-pill-border) 20%, transparent);
  }
  .contact-links dt,
  .contact-links dd {
    margin: 0;
  }
  .contact-links dt {
    color: var(--headline);
  }
  .contact-links a {
    color: var(--headline);
  }
  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--subheadline);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .contact-portrait-container {
    width: 100%;
    max-width: 370px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 28px;
  }
  .contact-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  @media (max-width: 760px) {
    .contact-section {
      width: 100%;
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 28px;
    }
    .contact-portrait {
      max-width: 370px;
    }
    .contact-links {
      margin-top: 36px;
    }
  }
  @media (max-width: 480px) {
    .contact-links div {
      min-height: 58px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }
  }
</style>
