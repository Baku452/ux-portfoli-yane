---
import { Icon } from "astro-icon/components";
import type { Homepage } from "../../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
---

<section
  data-nav-section
  id="about-me"
  class="about-me"
  aria-labelledby="about-me-title"
>
  <div class="about-top">
    <div class="about-copy">
      <p class="section-eyebrow">{page.aboutMe.eyebrow}</p>
      <h2 class="section-title" id="about-me-title">
        {page.aboutMe.title}
      </h2>
      {page.aboutMe.paragraphs.map((paragraph) => (
        <p class="about-paragraph">{paragraph}</p>
      ))}
    </div>
    <div class="about-aside">
      <a class="cv-link" href={page.resumeUrl} download>
        <Icon name="hugeicons:download-01" size={22} aria-hidden="true" />
        {page.labels.downloadCv}
      </a>
      <dl class="facts">
        {page.aboutMe.facts.map((fact) => (
          <div class="fact-row">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="about-group">
    <h3>{page.aboutMe.experienceTitle}</h3>
    <ol class="experience-list">
      {page.aboutMe.experience.map((item) => (
        <li>
          <span class="period">{item.period}</span>
          <span class="position">
            {item.role} · {item.organization}
          </span>
        </li>
      ))}
    </ol>
  </div>

  <div class="about-group skills-group">
    <h3>{page.aboutMe.skillsTitle}</h3>
    <ul class="skills-list">
      {page.aboutMe.skills.map((skill) => (
        <li>{skill}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-me {
    width: min(1180px, calc(100% - 64px));
    margin: 0 auto;
    padding: 20px 0 110px;
    scroll-margin-top: 24px;
  }
  .about-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(310px, 1fr);
    gap: clamp(36px, 5vw, 72px);
  }
  .about-copy .section-eyebrow {
    margin-bottom: 20px;
  }
  .about-copy .section-title {
    margin-bottom: 26px;
  }
  .about-paragraph {
    max-width: 65ch;
    margin: 0 0 8px;
    color: #818697;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.45;
  }
  .about-aside {
    padding-top: 8px;
  }
  .cv-link {
    display: flex;
    width: fit-content;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 0 26px auto;
    padding: 12px 26px;
    border-radius: 999px;
    background: var(--button-background);
    color: var(--button-text);
    font-weight: 800;
  }
  .cv-link:hover,
  .cv-link:focus-visible {
    background: #cdd1e0;
  }
  .facts {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .fact-row {
    display: flex;
    min-height: 68px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 22px;
    border-radius: 19px;
    background: white;
  }
  .fact-row dt {
    flex-shrink: 0;
    color: #858b9a;
  }
  .fact-row dd {
    margin: 0;
    text-align: right;
  }
  .about-group {
    margin-top: 38px;
  }
  .about-group h3 {
    margin: 0 0 24px;
    color: var(--headline);
    font: 800 clamp(1.6rem, 2.4vw, 2rem)/1.2 var(--font-heading);
  }
  .experience-list,
  .skills-list {
    list-style: none;
    padding: 0;
  }
  .experience-list {
    display: grid;
    gap: 13px;
    margin: 0;
  }
  .experience-list li {
    display: flex;
    min-height: 68px;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 16px 26px;
    border-radius: 18px;
    background: white;
  }
  .period {
    color: #858b9a;
  }
  .position {
    text-align: right;
  }
  .skills-group {
    margin-top: 32px;
  }
  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
  .skills-list li {
    padding: 12px 22px;
    border-radius: 999px;
    background: white;
    color: var(--headline);
  }
  @media (max-width: 900px) {
    .about-top {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .about-aside {
      display: flex;
      flex-direction: column-reverse;
      padding-top: 0;
    }
    .cv-link {
      margin: 22px 0 0;
    }
  }
  @media (max-width: 650px) {
    .about-me {
      width: calc(100% - 28px);
      padding: 8px 0 110px;
    }
    .about-copy .section-title {
      margin-bottom: 18px;
    }
    .fact-row,
    .experience-list li {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
    .fact-row dd,
    .position {
      text-align: left;
    }
    .skills-list {
      gap: 8px;
    }
    .skills-list li {
      padding: 9px 14px;
      font-size: 0.9rem;
    }
  }
</style>
