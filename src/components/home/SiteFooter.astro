---
import type { Homepage } from "../../content/homepage";

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>© {page.name.toUpperCase()} — {year}</p>
</footer>

<style>
  .site-footer {
    display: flex;
    min-height: max(280px, calc(100svh - 600px - var(--section-gap)));
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 72px;
    text-align: center;
  }
  .site-footer p {
    margin: 0;
    color: var(--subheadline);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  @media (max-width: 650px) {
    .site-footer {
      min-height: 180px;
      padding: 0 0 110px;
    }
  }
</style>
