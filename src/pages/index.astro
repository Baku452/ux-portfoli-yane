---
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import NavBar from "../components/NavBar.astro";
import Services from "../components/Services.astro";
import { homepage } from "../content/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${homepage.name} — ${homepage.role}`}
  description={homepage.introduction}
>
  <div class="site-shell" id="top">
    <NavBar email={homepage.email} />
    <main class="portfolio-grid">
      <About page={homepage} />
      <div class="dashboard">
        <Hero page={homepage} />
        <Services
          services={homepage.services}
          yearsExperience={homepage.yearsExperience}
          projectCount={homepage.projectCount}
        />
        <Footer
          role={homepage.role}
          about={homepage.aboutBody}
          location={homepage.location}
          resumeUrl={homepage.resumeUrl}
        />
      </div>
    </main>
  </div>
</BaseLayout>
