---
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import NavBar from "../components/NavBar.astro";
import Services from "../components/Services.astro";
import { homepage } from "../content/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${homepage.name} — ${homepage.role}`}
  description={homepage.introduction}
>
  <NavBar name={homepage.name} email={homepage.email} />

  <main id="top">
    <Hero page={homepage} />
    <About title={homepage.aboutTitle} body={homepage.aboutBody} />
    <Services services={homepage.services} />
  </main>

  <Footer name={homepage.name} email={homepage.email} />
</BaseLayout>
