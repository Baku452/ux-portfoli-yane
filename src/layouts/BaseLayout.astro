---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #171714;
    --paper: #f1efe8;
    --acid: #dfff57;
    --muted: #6a6961;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "DM Sans", sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 4vw;
    border-bottom: 1px solid #1717142e;
  }

  .brand {
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: clamp(22px, 4vw, 56px);
    font-size: 0.9rem;
  }

  nav a,
  .hero-footer a,
  footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  main,
  footer {
    margin-inline: 4vw;
  }

  .hero {
    display: flex;
    min-height: 82vh;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(48px, 9vh, 108px) 0 36px;
  }

  .eyebrow,
  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 1100px;
    margin: auto 0 12px;
    font:
      500 clamp(4.2rem, 12vw, 10.5rem) / 0.82 "Manrope",
      sans-serif;
    letter-spacing: -0.075em;
  }

  .intro {
    max-width: 690px;
    margin: 16px 0 60px;
    font-size: clamp(1.25rem, 2.5vw, 2.1rem);
    line-height: 1.28;
    letter-spacing: -0.035em;
  }

  .hero-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero-footer a,
  footer a {
    padding-bottom: 3px;
    border-bottom: 1px solid;
    color: var(--ink);
  }

  .about,
  .services {
    display: grid;
    padding: 120px 0;
    border-top: 1px solid #1717142e;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
  }

  h2 {
    max-width: 850px;
    margin: 0;
    font:
      500 clamp(2.4rem, 6vw, 5.6rem) / 1 "Manrope",
      sans-serif;
    letter-spacing: -0.06em;
  }

  .about div > p {
    max-width: 680px;
    margin: 45px 0 0 auto;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .service-list article {
    display: grid;
    padding: 28px 0;
    border-top: 1px solid #1717142e;
    grid-template-columns: 50px 1fr 1.2fr;
    gap: 24px;
  }

  .service-list article:first-child {
    padding-top: 0;
    border-top: 0;
  }

  article span {
    color: var(--muted);
    font-size: 0.75rem;
  }

  h3 {
    margin: 0;
    font:
      500 1.45rem "Manrope",
      sans-serif;
    letter-spacing: -0.03em;
  }

  article p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  footer {
    margin-bottom: 4vw;
    padding: clamp(60px, 10vw, 130px) clamp(30px, 6vw, 90px) 35px;
    background: var(--ink);
    color: var(--paper);
  }

  footer p {
    max-width: 900px;
    margin: 0 0 45px;
    font:
      500 clamp(2.8rem, 7vw, 7rem) / 0.98 "Manrope",
      sans-serif;
    letter-spacing: -0.06em;
  }

  footer a {
    color: var(--acid);
  }

  footer small {
    display: block;
    margin-top: 100px;
    color: #aaa99f;
  }

  @media (max-width: 700px) {
    header {
      padding-block: 22px;
    }

    nav a:first-child {
      display: none;
    }

    .hero {
      min-height: 76vh;
    }

    h1 {
      font-size: clamp(3.7rem, 19vw, 7rem);
    }

    .hero-footer {
      flex-direction: column;
    }

    .about,
    .services {
      padding: 80px 0;
      grid-template-columns: 1fr;
    }

    .about div > p {
      margin-left: 0;
    }

    .service-list article {
      grid-template-columns: 34px 1fr;
    }

    .service-list article p {
      grid-column: 2;
    }
  }
</style>
