---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Baloo 2";
    src: url("/fonts/baloo-2-variable.ttf") format("truetype");
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
  }

  @font-face {
    font-family: "Inter";
    src: url("/fonts/inter-variable.ttf") format("truetype");
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    --font-heading: "Baloo 2", sans-serif;
    --font-body: "Inter", sans-serif;
    /* Core interface */
    --background: #fbf9f3;
    --headline: #6f779d;
    --subheadline: #15161c;
    --button-background: #d9dbe5;
    --button-text: #6f779d;

    /* Illustration */
    --illustration-stroke: #fbf9f3;
    --illustration-main: #ffffff;
    --illustration-secondary: #6f779d;
    --illustration-tertiary: #d9dbe5;
    --highlight-purple: #9b7ac9;
    --highlight-green: #1e5b47;
    --highlight-yellow: #f1cb8c;

    /* Case-study and project pills */
    --featured-pill-background: #d9dbe5;
    --featured-pill-border: #6f779d;
    --card-pill-background: #ece6ec;
    --card-pill-border: #9b7ac9;
    --contact-gradient: linear-gradient(135deg, #d6d8e3 0%, #edeef2 100%);
    --content-gutter: 250px;

    /* Semantic aliases used by the site */
    --ink: var(--subheadline);
    --paper: var(--background);
    --white: var(--illustration-main);
    --lavender: var(--headline);
    --lavender-soft: var(--illustration-tertiary);
    --purple: var(--highlight-purple);
    --mint: var(--highlight-green);
    --sand: var(--highlight-yellow);
    --radius: 28px;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .section-eyebrow {
    margin: 0 0 8px;
    color: var(--subheadline);
    font-size: 12px;
    letter-spacing: 1.15px;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .section-title {
    margin: 0;
    color: var(--headline);
    font: 800 36px/1.1 var(--font-heading);
  }

  .site-shell {
    min-height: 100vh;
  }
  .content-layout {
    width: calc(100% - (var(--content-gutter) * 2));
    margin: 0 auto;
  }

  .side-rail {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    display: flex;
    height: 100vh;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 30px 12px;
    border-right: 1px solid var(--illustration-tertiary);
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(18px);
  }

  .monogram {
    display: block;
    width: 47px;
    height: 47px;
  }
  .monogram img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .side-rail nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .side-rail nav a,
  .rail-mail {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 13px;
    color: var(--lavender);
    transition: 180ms ease;
  }
  .language-toggle {
    position: fixed;
    top: 22px;
    right: 24px;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border: 1px solid var(--illustration-tertiary);
    border-radius: 999px;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 8px 24px rgb(111 119 157 / 9%);
    backdrop-filter: blur(16px);
    isolation: isolate;
    cursor: pointer;
  }
  .language-toggle > span:not(.toggle-thumb) {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 38px;
    height: 30px;
    place-items: center;
    border-radius: 999px;
    color: var(--lavender);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    transition: color 180ms ease;
  }
  .toggle-thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 38px;
    height: 30px;
    background: var(--lavender);
    border-radius: 999px;
    box-shadow: 0 4px 12px rgb(111 119 157 / 22%);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .language-toggle[data-locale="es"] .toggle-thumb {
    transform: translateX(38px);
  }
  .language-toggle[data-locale="en"] > span[lang="en"],
  .language-toggle[data-locale="es"] > span[lang="es"] {
    color: white;
  }
  .language-toggle:focus-visible {
    outline: 2px solid var(--purple);
    outline-offset: 2px;
  }
  .language-toggle:hover .toggle-thumb {
    box-shadow: 0 5px 16px rgb(111 119 157 / 32%);
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle-thumb,
    .language-toggle > span:not(.toggle-thumb) {
      transition: none;
    }
  }
  .side-rail nav a:hover,
  .side-rail nav a:focus-visible,
  .side-rail nav a.active {
    background: var(--lavender-soft);
    color: var(--button-text);
    outline: none;
  }

  .portfolio-grid {
    display: grid;
    width: 100%;
    margin: auto;
    padding: 52px 0;
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
    gap: 20px;
  }
  .dashboard {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .profile-card {
    position: sticky;
    top: 52px;
    display: flex;
    height: calc(100vh - 104px);
    min-height: 640px;
    max-height: 760px;
    flex-direction: column;
    overflow: hidden;
    padding: 24px 24px 0;
    border-radius: var(--radius);
    background-color: var(--button-background);
    color: var(--button-text);
  }
  .availability {
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .profile-copy {
    position: relative;
    z-index: 1;
    margin-top: 42px;
  }
  .profile-copy h2 {
    margin: 0 0 18px;
    font: 800 clamp(1.7rem, 3vw, 2.2rem)/1 var(--font-heading);
  }
  .profile-copy p {
    max-width: 28ch;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .portrait {
    position: relative;
    min-height: 290px;
    flex: 1;
    margin: 30px -24px 0;
    overflow: hidden;
  }
  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .masthead {
    display: flex;
    min-height: 218px;
    flex-direction: column;
    justify-content: center;
    padding: 34px 40px;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--lavender);
  }
  .masthead p {
    margin: 0 0 14px;
    font-size: 1.65rem;
    font-weight: 800;
  }
  .masthead h1 {
    margin: 0;
    font: 800 clamp(4rem, 8vw, 6.5rem)/0.88 var(--font-heading);
  }
  .masthead h1 span {
    color: var(--purple);
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 18px;
  }
  .featured-work {
    position: relative;
    display: flex;
    min-height: 255px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--highlight-yellow);
    border-radius: var(--radius);
    background: radial-gradient(
      circle at 40% 20%,
      var(--illustration-main),
      var(--sand)
    );
  }
  .project-kicker {
    position: absolute;
    top: 24px;
    left: 28px;
    color: var(--subheadline);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .project-arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: var(--illustration-main);
    box-shadow: 0 8px 20px rgb(21 22 28 / 16%);
  }
  .project-window {
    width: min(72%, 390px);
    overflow: hidden;
    border: 1px solid var(--illustration-tertiary);
    border-radius: 13px;
    background: var(--illustration-main);
    box-shadow: 0 22px 28px rgb(21 22 28 / 22%);
    transform: translateY(18px);
  }
  .window-bar {
    display: flex;
    height: 28px;
    align-items: center;
    gap: 5px;
    padding: 0 12px;
    background: var(--background);
  }
  .window-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--illustration-tertiary);
  }
  .window-body {
    display: grid;
    min-height: 128px;
    align-content: center;
    padding: 24px;
    background: linear-gradient(
      90deg,
      var(--illustration-secondary) 48%,
      var(--background) 48%
    );
    color: var(--illustration-main);
  }
  .window-body span {
    display: block;
    width: 34%;
    height: 8px;
    margin-top: 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 45%);
  }

  .metrics {
    display: grid;
    gap: 18px;
  }
  .metric {
    display: flex;
    min-height: 118px;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px 22px 20px;
    border-radius: 0 0 26px 26px;
  }
  .metric strong {
    font: 800 1.8rem var(--font-heading);
  }
  .metric span {
    font-size: 0.78rem;
  }
  .experience {
    background: var(--mint);
    color: var(--illustration-main);
  }
  .projects {
    background: var(--lavender);
    color: var(--illustration-main);
  }
  .service-strip {
    display: flex;
    grid-column: 1 / -1;
    flex-wrap: wrap;
    gap: 8px;
  }
  .service-strip span {
    padding: 9px 13px;
    border: 1px solid var(--illustration-tertiary);
    border-radius: 999px;
    background: var(--illustration-main);
    color: var(--subheadline);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .details-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 285px;
    gap: 18px;
  }
  .role-card {
    min-height: 145px;
    padding: 32px;
    border-radius: var(--radius);
    background: var(--lavender);
    color: var(--illustration-main);
  }
  .role-card h2 {
    margin: 0 0 8px;
    font: 700 clamp(1.5rem, 3vw, 2rem) var(--font-heading);
  }
  .role-card p {
    max-width: 65ch;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .quick-links {
    display: grid;
    gap: 14px;
  }
  .quick-links span,
  .quick-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 65px;
    padding: 16px;
    border-radius: 999px;
    background: var(--illustration-tertiary);
    color: var(--highlight-purple);
    font-weight: 700;
    text-align: center;
  }
  .quick-links a {
    background: var(--button-background);
    color: var(--button-text);
  }

  @media (max-width: 920px) {
    :root {
      --content-gutter: 20px;
    }
    .portfolio-grid {
      width: min(680px, 100%);
      grid-template-columns: 1fr;
    }
    .profile-card {
      position: relative;
      top: auto;
      height: 560px;
      min-height: 0;
    }
    .portrait {
      min-height: 260px;
    }
  }

  @media (max-width: 650px) {
    :root {
      --content-gutter: 14px;
    }
    .site-shell {
      display: block;
      padding-bottom: 78px;
    }
    .side-rail {
      position: fixed;
      top: auto;
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
      height: 62px;
      flex-direction: row;
      padding: 9px 12px;
      border: 1px solid var(--illustration-tertiary);
      border-radius: 20px;
      box-shadow: 0 14px 38px rgb(111 119 157 / 18%);
    }
    .side-rail nav {
      flex-direction: row;
    }
    .rail-mail {
      display: none;
    }
    .language-toggle {
      top: 14px;
      right: 14px;
    }
    .portfolio-grid {
      width: 100%;
      padding: 20px 0;
    }
    .profile-card {
      height: 520px;
    }
    .masthead {
      min-height: 170px;
      padding: 28px;
    }
    .masthead h1 {
      font-size: clamp(3.2rem, 17vw, 5rem);
    }
    .work-grid,
    .details-grid {
      grid-template-columns: 1fr;
    }
    .metrics {
      grid-template-columns: 1fr 1fr;
    }
    .metric {
      min-height: 125px;
    }
    .service-strip {
      grid-column: auto;
    }
    .quick-links {
      grid-template-columns: 1fr;
    }
  }
</style>
